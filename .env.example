# --- Application ---
BASE_URL=https://decipher-ranker.com

# --- Vercel Postgres (auto-set by Vercel when linked) ---
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- Vercel KV / Upstash Redis (auto-set by Vercel when linked) ---
# Also powers per-IP rate limiting on the free routes (reused, no separate
# config). When unset (or a mock:// placeholder), rate limiting is disabled.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- x402 / AgentCash ---
EVM_PAYEE_ADDRESS=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- x402scan outbound payments (optional) ---
# Private key of a Base wallet funded with USDC, used to pay x402scan's
# x402-protected stats API for merchant deep-dive enrichment. Leave empty to
# disable enrichment (all-time stats return null + all_time_stats_available: false).
X402SCAN_PAYER_PRIVATE_KEY=

# --- AI analyst (optional) ---
# OpenCode Zen API key (https://opencode.ai/docs/zen). Powers the LLM insights on
# the competitive report. Leave empty to disable — the report still returns full
# static analysis with ai_insights: null.
OPENCODE_API_KEY=

# --- MPP Protocol (Tempo) — second payment rail alongside x402 ---
# Enable by setting both of these; the router adds 'mpp' to paid routes.
# The MPP recipient reuses EVM_PAYEE_ADDRESS.
MPP_SECRET_KEY=          # openssl rand -hex 32 — persist across deploys
MPP_CURRENCY=0x20c000000000000000000000b9537d11c60e8b50  # Tempo USDC
# Optional (sessions / gas sponsorship — NOT used in v1, one-shot charge only):
# MPP_OPERATOR_KEY=      # only for payment-channel sessions
# MPP_FEE_PAYER_KEY=     # sponsor client gas; must differ from operator
# TEMPO_RPC_URL=         # defaults to https://rpc.tempo.xyz

# --- Cron Job Auth ---
CRON_SECRET=
