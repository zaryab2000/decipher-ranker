# --- Application ---
BASE_URL=https://decipher-ranker.com

# --- Vercel Postgres (auto-set by Vercel when linked) ---
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- Vercel KV / Upstash Redis (auto-set by Vercel when linked) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- x402 / AgentCash ---
EVM_PAYEE_ADDRESS=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- x402scan outbound payments (optional) ---
# Private key of a Base wallet funded with USDC, used to pay x402scan's
# x402-protected stats API for merchant deep-dive enrichment. Leave empty to
# disable enrichment (all-time stats return null + all_time_stats_available: false).
X402SCAN_PAYER_PRIVATE_KEY=

# --- MPP Protocol (optional, recommended) ---
MPP_SECRET_KEY=
MPP_OPERATOR_KEY=
# MPP_FEE_PAYER_KEY=  # Optional — omit to let callers pay their own gas

# --- Cron Job Auth ---
CRON_SECRET=
