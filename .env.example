# =============================================================================
# decipher-ranker — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# See docs/MANUAL_x402_SERVICE.md for setup instructions.
# =============================================================================

# --- Application ---
BASE_URL=https://decipher-ranker.com

# --- Vercel Postgres (auto-set by Vercel when linked) ---
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- Vercel KV / Upstash Redis (auto-set by Vercel when linked) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- x402 / AgentCash ---
EVM_PAYEE_ADDRESS=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- MPP Protocol (optional, recommended) ---
MPP_SECRET_KEY=
MPP_OPERATOR_KEY=
# MPP_FEE_PAYER_KEY=  # Optional — omit to let callers pay their own gas

# --- Cron Job Auth ---
CRON_SECRET=
